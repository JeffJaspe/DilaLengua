# PostgreSQL (Neon on Vercel: copy the pooled connection string). Create tables with: npm run db:push
DATABASE_URL="postgresql://user:password@host:5432/spanish?sslmode=require"

# Public base URL, used in certificate QR codes and verify links
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Optional: where generated lesson audio lives (Cloudflare R2 public bucket URL).
# Leave empty to use the browser's built-in Spanish voice.
NEXT_PUBLIC_AUDIO_BASE=""

# Optional: host for Whisper model files (R2). Empty = Hugging Face hub.
NEXT_PUBLIC_MODEL_BASE=""
